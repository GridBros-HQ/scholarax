datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum CampusType {
  PRIMARY
  SECONDARY
}

enum CurriculumType {
  CBC
  KCSE
}

enum SystemRoleName {
  OWNER
  ADMINISTRATOR
  TEACHER
  BURSAR
  PARENT
  STUDENT
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  SPONSOR
  GUARDIAN
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum TransferType {
  INTERNAL
  EXTERNAL_EXIT
  EXTERNAL_ENTRY
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  FULLY_PAID
}

enum PaymentMode {
  MPESA
  BANK_DEPOSIT
  CASH
}

enum AttendancePeriod {
  MORNING
  AFTERNOON
  SUBJECT_WISE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AudienceType {
  ALL
  STAFF
  PARENTS
}

enum SmsStatus {
  SENT
  FAILED
  PENDING
}

enum StockTransactionType {
  STOCK_IN
  STOCK_OUT
  DAMAGED
  ISSUED
}

// ==========================================
// MODELS
// ==========================================

model SchoolGroup {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @db.VarChar(255)
  slug       String     @unique @db.VarChar(255)
  created_at DateTime   @default(now()) @db.Timestamptz
  updated_at DateTime   @updatedAt @db.Timestamptz
  deleted_at DateTime?  @db.Timestamptz
  campuses   Campus[]
  audit_logs AuditLog[]

  @@map("school_groups")
}

model Campus {
  id             String         @id @default(uuid()) @db.Uuid
  schoolGroupId  String         @map("school_group_id") @db.Uuid
  name           String         @db.VarChar(255)
  code           String         @db.VarChar(50)
  curriculumType CurriculumType @map("curriculum_type")
  created_at     DateTime       @default(now()) @db.Timestamptz
  updated_at     DateTime       @updatedAt @db.Timestamptz
  deleted_at     DateTime?      @db.Timestamptz

  schoolGroup         SchoolGroup                @relation(fields: [schoolGroupId], references: [id], onDelete: Restrict)
  academic_years      AcademicYear[]
  terms               Term[]
  classes             Class[]
  streams             Stream[]
  students            Student[]
  medical_records     StudentMedicalRecord[]
  discipline_records  StudentDisciplineRecord[]
  transfers_out       StudentTransfer[]          @relation("SourceCampus")
  transfers_in        StudentTransfer[]          @relation("DestinationCampus")
  departments         Department[]
  staff_assignments   StaffAssignment[]
  fee_categories      FeeCategory[]
  fee_structures      FeeStructure[]
  fee_assignments     StudentFeeAssignment[]
  fee_invoices        FeeInvoice[]
  fee_payments        FeePayment[]
  payment_receipts    PaymentReceipt[]
  subjects            Subject[]
  class_subjects      ClassSubject[]
  teacher_subjects    TeacherSubjectAssignment[]
  attendance_sessions AttendanceSession[]
  attendance_records  AttendanceRecord[]
  announcements       Announcement[]
  notif_templates     NotificationTemplate[]
  sms_logs            SmsLog[]
  inventory_cats      InventoryCategory[]
  inventory_items     InventoryItem[]
  inventory_txs       InventoryTransaction[]
  users               User[]
  roles               Role[]
  userRoles           UserRole[]

  @@unique([schoolGroupId, code])
  @@index([schoolGroupId])
  @@map("campuses")
}

model AcademicYear {
  id         String    @id @default(uuid()) @db.Uuid
  campus_id  String    @db.Uuid
  name       String    @db.VarChar(100)
  start_date DateTime  @db.Date
  end_date   DateTime  @db.Date
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  campus Campus @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  terms  Term[]

  @@unique([campus_id, name])
  @@index([campus_id, is_active])
  @@map("academic_years")
}

model Term {
  id               String   @id @default(uuid()) @db.Uuid
  campus_id        String   @db.Uuid
  academic_year_id String   @db.Uuid
  name             String   @db.VarChar(100)
  start_date       DateTime @db.Date
  end_date         DateTime @db.Date
  is_active        Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz

  campus         Campus         @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  academic_year  AcademicYear   @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  fee_structures FeeStructure[]
  fee_invoices   FeeInvoice[]

  @@index([academic_year_id])
  @@index([campus_id, is_active])
  @@map("terms")
}

model Class {
  id         String         @id @default(uuid()) @db.Uuid
  campus_id  String         @db.Uuid
  name       String         @db.VarChar(100)
  track_type CurriculumType
  created_at DateTime       @default(now()) @db.Timestamptz
  updated_at DateTime       @updatedAt @db.Timestamptz

  campus         Campus         @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  streams        Stream[]
  fee_structures FeeStructure[]
  class_subjects ClassSubject[]

  @@unique([campus_id, name])
  @@map("classes")
}

model Stream {
  id         String   @id @default(uuid()) @db.Uuid
  campus_id  String   @db.Uuid
  class_id   String   @db.Uuid
  name       String   @db.VarChar(100)
  capacity   Int
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  campus           Campus                     @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  class            Class                      @relation(fields: [class_id], references: [id], onDelete: Cascade)
  students         Student[]
  teacher_subjects TeacherSubjectAssignment[]
  attendances      AttendanceSession[]

  @@unique([class_id, name])
  @@map("streams")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  campusId     String    @map("campus_id") @db.Uuid
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String    @unique @map("phone_number") @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  deleted_at   DateTime? @db.Timestamptz

  campus        Campus                 @relation(fields: [campusId], references: [id], onDelete: Restrict)
  userRoles     UserRole[]
  guardians     Guardian[]
  staff         Staff[]
  audit_logs    AuditLog[]
  inventory_txs InventoryTransaction[]

  @@unique([campusId, email])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  campusId    String     @map("campus_id") @db.Uuid
  name        String     @db.VarChar(100)
  slug        String     @db.VarChar(100)
  description String?    @db.Text
  created_at  DateTime   @default(now()) @db.Timestamptz
  campus      Campus     @relation(fields: [campusId], references: [id], onDelete: Restrict)
  userRoles   UserRole[]

  @@unique([campusId, slug])
  @@map("roles")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  campusId    String   @map("campus_id") @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@unique([userId, roleId, campusId])
  @@map("user_roles")
}

model Student {
  id               String        @id @default(uuid()) @db.Uuid
  campus_id        String        @db.Uuid
  stream_id        String        @db.Uuid
  admission_number String        @db.VarChar(100)
  first_name       String        @db.VarChar(100)
  last_name        String        @db.VarChar(100)
  date_of_birth    DateTime      @db.Date
  gender           String        @db.VarChar(20)
  enrollment_date  DateTime      @db.Date
  status           StudentStatus @default(ACTIVE)
  created_at       DateTime      @default(now()) @db.Timestamptz
  updated_at       DateTime      @updatedAt @db.Timestamptz
  deleted_at       DateTime?     @db.Timestamptz

  campus          Campus                    @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  stream          Stream                    @relation(fields: [stream_id], references: [id], onDelete: Restrict)
  guardians       StudentGuardian[]
  medical_record  StudentMedicalRecord?
  discipline_logs StudentDisciplineRecord[]
  transfers       StudentTransfer[]
  fee_assignments StudentFeeAssignment[]
  fee_invoices    FeeInvoice[]
  attendance_logs AttendanceRecord[]

  @@unique([campus_id, admission_number])
  @@index([stream_id])
  @@map("students")
}

model Guardian {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String?  @db.Uuid
  first_name   String   @db.VarChar(100)
  last_name    String   @db.VarChar(100)
  national_id  String   @unique @db.VarChar(100)
  phone_number String   @db.VarChar(50)
  email        String?  @db.VarChar(255)
  profession   String?  @db.VarChar(150)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  user     User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@index([phone_number])
  @@map("guardians")
}

model StudentGuardian {
  student_id         String               @db.Uuid
  guardian_id        String               @db.Uuid
  relationship_type  GuardianRelationship
  is_primary_contact Boolean              @default(false)

  student  Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardian_id], references: [id], onDelete: Restrict)

  @@id([student_id, guardian_id])
  @@map("student_guardians")
}

model StudentMedicalRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  campus_id          String   @db.Uuid
  student_id         String   @unique @db.Uuid
  blood_group        String?  @db.VarChar(10)
  allergies          String?  @db.Text
  medical_conditions String?  @db.Text
  emergency_notes    String?  @db.Text
  created_at         DateTime @default(now()) @db.Timestamptz
  updated_at         DateTime @updatedAt @db.Timestamptz

  campus  Campus  @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([campus_id, student_id])
  @@map("student_medical_records")
}

model StudentDisciplineRecord {
  id            String   @id @default(uuid()) @db.Uuid
  campus_id     String   @db.Uuid
  student_id    String   @db.Uuid
  incident_date DateTime @db.Date
  infraction    String   @db.VarChar(255)
  action_taken  String   @db.VarChar(255)
  status        String   @db.VarChar(50)
  created_at    DateTime @default(now()) @db.Timestamptz

  campus  Campus  @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([campus_id, student_id])
  @@map("student_discipline_records")
}

model StudentTransfer {
  id                    String       @id @default(uuid()) @db.Uuid
  student_id            String       @db.Uuid
  source_campus_id      String?      @db.Uuid
  destination_campus_id String?      @db.Uuid
  transfer_type         TransferType
  reason                String       @db.Text
  transfer_date         DateTime     @db.Date
  created_at            DateTime     @default(now()) @db.Timestamptz

  student            Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  source_campus      Campus? @relation("SourceCampus", fields: [source_campus_id], references: [id], onDelete: Restrict)
  destination_campus Campus? @relation("DestinationCampus", fields: [destination_campus_id], references: [id], onDelete: Restrict)

  @@index([student_id])
  @@map("student_transfers")
}

model Staff {
  id            String      @id @default(uuid()) @db.Uuid
  user_id       String      @db.Uuid
  employee_code String      @unique @db.VarChar(100)
  designation   String      @db.VarChar(150)
  joining_date  DateTime    @db.Date
  status        StaffStatus @default(ACTIVE)
  created_at    DateTime    @default(now()) @db.Timestamptz
  updated_at    DateTime    @updatedAt @db.Timestamptz

  user        User                       @relation(fields: [user_id], references: [id], onDelete: Restrict)
  assignments StaffAssignment[]
  subjects    TeacherSubjectAssignment[]

  @@map("staff")
}

model Department {
  id         String   @id @default(uuid()) @db.Uuid
  campus_id  String   @db.Uuid
  name       String   @db.VarChar(150)
  created_at DateTime @default(now()) @db.Timestamptz

  campus      Campus            @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  assignments StaffAssignment[]

  @@unique([campus_id, name])
  @@map("departments")
}

model StaffAssignment {
  id                String   @id @default(uuid()) @db.Uuid
  staff_id          String   @db.Uuid
  campus_id         String   @db.Uuid
  department_id     String?  @db.Uuid
  is_primary_campus Boolean  @default(true)
  assigned_at       DateTime @default(now()) @db.Timestamptz

  staff      Staff       @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  campus     Campus      @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)

  @@index([staff_id, campus_id])
  @@map("staff_assignments")
}

model FeeCategory {
  id          String   @id @default(uuid()) @db.Uuid
  campus_id   String   @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz

  campus Campus             @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  items  FeeStructureItem[]

  @@unique([campus_id, name])
  @@map("fee_categories")
}

model FeeStructure {
  id         String   @id @default(uuid()) @db.Uuid
  campus_id  String   @db.Uuid
  term_id    String   @db.Uuid
  class_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  campus      Campus                 @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  term        Term                   @relation(fields: [term_id], references: [id], onDelete: Restrict)
  class       Class                  @relation(fields: [class_id], references: [id], onDelete: Restrict)
  items       FeeStructureItem[]
  assignments StudentFeeAssignment[]

  @@unique([term_id, class_id])
  @@map("fee_structures")
}

model FeeStructureItem {
  id               String   @id @default(uuid()) @db.Uuid
  fee_structure_id String   @db.Uuid
  fee_category_id  String   @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  created_at       DateTime @default(now()) @db.Timestamptz

  fee_structure FeeStructure @relation(fields: [fee_structure_id], references: [id], onDelete: Cascade)
  category      FeeCategory  @relation(fields: [fee_category_id], references: [id], onDelete: Restrict)

  @@map("fee_structure_items")
}

model StudentFeeAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  campus_id        String   @db.Uuid
  student_id       String   @db.Uuid
  fee_structure_id String   @db.Uuid
  custom_discount  Decimal  @default(0.00) @db.Decimal(12, 2)
  notes            String?  @db.Text
  created_at       DateTime @default(now()) @db.Timestamptz

  campus        Campus       @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  student       Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  fee_structure FeeStructure @relation(fields: [fee_structure_id], references: [id], onDelete: Restrict)

  @@unique([student_id, fee_structure_id])
  @@map("student_fee_assignments")
}

model FeeInvoice {
  id           String        @id @default(uuid()) @db.Uuid
  campus_id    String        @db.Uuid
  student_id   String        @db.Uuid
  term_id      String        @db.Uuid
  total_amount Decimal       @db.Decimal(12, 2)
  paid_amount  Decimal       @default(0.00) @db.Decimal(12, 2)
  status       InvoiceStatus @default(UNPAID)
  created_at   DateTime      @default(now()) @db.Timestamptz
  updated_at   DateTime      @updatedAt @db.Timestamptz

  campus   Campus       @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  student  Student      @relation(fields: [student_id], references: [id], onDelete: Restrict)
  term     Term         @relation(fields: [term_id], references: [id], onDelete: Restrict)
  payments FeePayment[]

  @@unique([student_id, term_id])
  @@index([campus_id, status])
  @@map("fee_invoices")
}

model FeePayment {
  id             String      @id @default(uuid()) @db.Uuid
  campus_id      String      @db.Uuid
  fee_invoice_id String      @db.Uuid
  amount         Decimal     @db.Decimal(12, 2)
  payment_mode   PaymentMode
  mpesa_trans_id String?     @unique @db.VarChar(100)
  payment_date   DateTime    @db.Timestamptz
  created_at     DateTime    @default(now()) @db.Timestamptz

  campus   Campus           @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  invoice  FeeInvoice       @relation(fields: [fee_invoice_id], references: [id], onDelete: Restrict)
  receipts PaymentReceipt[]

  @@index([campus_id, payment_mode])
  @@map("fee_payments")
}

model PaymentReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  campus_id      String   @db.Uuid
  fee_payment_id String   @db.Uuid
  receipt_number String   @unique @db.VarChar(100)
  issued_at      DateTime @default(now()) @db.Timestamptz

  campus  Campus     @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  payment FeePayment @relation(fields: [fee_payment_id], references: [id], onDelete: Restrict)

  @@map("payment_receipts")
}

model Subject {
  id              String         @id @default(uuid()) @db.Uuid
  campus_id       String         @db.Uuid
  name            String         @db.VarChar(150)
  code            String         @db.VarChar(50)
  curriculum_type CurriculumType
  created_at      DateTime       @default(now()) @db.Timestamptz

  campus   Campus                     @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  classes  ClassSubject[]
  teachers TeacherSubjectAssignment[]

  @@unique([campus_id, code])
  @@map("subjects")
}

model ClassSubject {
  id         String   @id @default(uuid()) @db.Uuid
  campus_id  String   @db.Uuid
  class_id   String   @db.Uuid
  subject_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  campus  Campus  @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  class   Class   @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Restrict)

  @@unique([class_id, subject_id])
  @@map("class_subjects")
}

model TeacherSubjectAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  campus_id   String   @db.Uuid
  staff_id    String   @db.Uuid
  stream_id   String   @db.Uuid
  subject_id  String   @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz

  campus  Campus  @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  staff   Staff   @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  stream  Stream  @relation(fields: [stream_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Restrict)

  @@unique([stream_id, subject_id])
  @@index([staff_id])
  @@map("teacher_subject_assignments")
}

model AttendanceSession {
  id           String           @id @default(uuid()) @db.Uuid
  campus_id    String           @db.Uuid
  stream_id    String           @db.Uuid
  session_date DateTime         @db.Date
  period_type  AttendancePeriod
  created_at   DateTime         @default(now()) @db.Timestamptz

  campus  Campus             @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  stream  Stream             @relation(fields: [stream_id], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@index([campus_id, session_date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                    String           @id @default(uuid()) @db.Uuid
  campus_id             String           @db.Uuid
  attendance_session_id String           @db.Uuid
  student_id            String           @db.Uuid
  status                AttendanceStatus
  remarks               String?          @db.VarChar(255)
  updated_at            DateTime         @updatedAt @db.Timestamptz

  campus  Campus            @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  session AttendanceSession @relation(fields: [attendance_session_id], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([attendance_session_id, student_id])
  @@map("attendance_records")
}

model Announcement {
  id              String       @id @default(uuid()) @db.Uuid
  campus_id       String       @db.Uuid
  title           String       @db.VarChar(255)
  content         String       @db.Text
  target_audience AudienceType
  published_at    DateTime     @default(now()) @db.Timestamptz

  campus Campus @relation(fields: [campus_id], references: [id], onDelete: Restrict)

  @@index([campus_id, target_audience])
  @@map("announcements")
}

model NotificationTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  campus_id      String  @db.Uuid
  trigger_event  String  @db.VarChar(100)
  sms_template   String  @db.Text
  email_template String  @db.Text
  is_enabled     Boolean @default(true)

  campus Campus @relation(fields: [campus_id], references: [id], onDelete: Restrict)

  @@unique([campus_id, trigger_event])
  @@map("notification_templates")
}

model SmsLog {
  id              String    @id @default(uuid()) @db.Uuid
  campus_id       String    @db.Uuid
  recipient_phone String    @db.VarChar(50)
  message_body    String    @db.Text
  status          SmsStatus @default(PENDING)
  cost_units      Int       @default(0)
  sent_at         DateTime  @default(now()) @db.Timestamptz

  campus Campus @relation(fields: [campus_id], references: [id], onDelete: Restrict)

  @@index([campus_id, sent_at])
  @@map("sms_logs")
}

model InventoryCategory {
  id         String   @id @default(uuid()) @db.Uuid
  campus_id  String   @db.Uuid
  name       String   @db.VarChar(150)
  created_at DateTime @default(now()) @db.Timestamptz

  campus Campus          @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  items  InventoryItem[]

  @@unique([campus_id, name])
  @@map("inventory_categories")
}

model InventoryItem {
  id                    String   @id @default(uuid()) @db.Uuid
  campus_id             String   @db.Uuid
  inventory_category_id String   @db.Uuid
  name                  String   @db.VarChar(255)
  sku                   String?  @db.VarChar(100)
  total_quantity        Int      @default(0)
  available_quantity    Int      @default(0)
  updated_at            DateTime @updatedAt @db.Timestamptz

  campus       Campus                 @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  category     InventoryCategory      @relation(fields: [inventory_category_id], references: [id], onDelete: Restrict)
  transactions InventoryTransaction[]

  @@unique([campus_id, name])
  @@index([inventory_category_id])
  @@map("inventory_items")
}

model InventoryTransaction {
  id                String               @id @default(uuid()) @db.Uuid
  campus_id         String               @db.Uuid
  inventory_item_id String               @db.Uuid
  quantity          Int
  type              StockTransactionType
  reference_notes   String?              @db.Text
  performed_by      String               @db.Uuid
  created_at        DateTime             @default(now()) @db.Timestamptz

  campus Campus        @relation(fields: [campus_id], references: [id], onDelete: Restrict)
  item   InventoryItem @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [performed_by], references: [id], onDelete: Restrict)

  @@index([inventory_item_id])
  @@map("inventory_transactions")
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  school_group_id String?  @db.Uuid
  user_id         String?  @db.Uuid
  action          String   @db.VarChar(150)
  entity_type     String   @db.VarChar(100)
  entity_id       String   @db.VarChar(100)
  ip_address      String?  @db.VarChar(45)
  timestamp       DateTime @default(now()) @db.Timestamptz

  school_group SchoolGroup? @relation(fields: [school_group_id], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id])
  @@index([timestamp])
  @@map("audit_logs")
}
